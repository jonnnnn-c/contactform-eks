# ---------------------------------------------------------------------------
# Copy this file to terraform.tfvars and edit the values for your environment:
#     cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars is git-ignored (it holds your IP / email), so your real
# values never get committed. Every setting below has a matching variable in
# variables.tf with a description.
# ---------------------------------------------------------------------------

# --- Naming -----------------------------------------------------------------
project     = "contact-app" # name prefix for all resources
environment = "dev"         # dev / staging / prod
region      = "ap-southeast-1"

# --- Networking -------------------------------------------------------------
vpc_cidr           = "10.20.0.0/16"
az_count           = 2     # number of Availability Zones to spread across
single_nat_gateway = true  # true = 1 NAT (cheaper, dev); false = 1 per AZ (HA)

# --- EKS cluster + nodes ----------------------------------------------------
kubernetes_version  = "1.36" # use a currently-supported version
node_instance_types = ["t3.medium"]
node_desired_size   = 2
node_min_size       = 2
node_max_size       = 4

# --- API access -------------------------------------------------------------
# REQUIRED: lock the public Kubernetes API to YOUR workstation IP only.
# Find yours with:  curl -s https://checkip.amazonaws.com
# Never use 0.0.0.0/0 - that exposes the API server to the whole internet.
cluster_public_access_cidrs = ["203.0.113.10/32"] # <-- replace with YOUR.IP/32

# --- Security controls ------------------------------------------------------
enable_security_controls = true # CloudTrail, Config, KMS, ECR scan, flow logs
enable_threat_detection  = true # GuardDuty + Security Hub (needs an activated
#                                  account; set false on brand-new accounts that
#                                  return SubscriptionRequiredException)

# --- Cost guardrail (AWS Budgets) -------------------------------------------
# Leave budget_notification_emails empty to skip the budget entirely.
budget_limit_usd           = 100          # monthly USD limit
budget_alert_thresholds    = [50, 80, 100] # % of the limit -> email at each
budget_notification_emails = ["you@example.com"] # <-- your email(s)
